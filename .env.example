# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.
# docker-compose reads these automatically from a .env file in the same directory.

# Grafana admin credentials (local dashboard only — not used in CI).
# Required: docker-compose will fail loudly with a blank password if this is unset.
GF_SECURITY_ADMIN_PASSWORD=
GF_SECURITY_ADMIN_USER=admin

# Used by ai_security_advisor.py / ai_correlation_engine.py when running locally
# outside CI (in GitHub Actions these come from repo Secrets instead).
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
