{
  "title": "DevSecOps Security Dashboard",
  "uid": "devsecops-main",
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Pipeline Status",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "security_pipeline_status", "datasource": {"type": "prometheus"}}],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "✅ PASSED", "color": "green"}}},
            {"type": "value", "options": {"1": {"text": "❌ FAILED", "color": "red"}}}
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "HIGH Findings",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "security_total_high", "datasource": {"type": "prometheus"}}],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 1}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      }
    },
    {
      "id": 3,
      "title": "MEDIUM Findings",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "security_total_medium", "datasource": {"type": "prometheus"}}],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      }
    },
    {
      "id": 4,
      "title": "Findings by Scanner",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "security_findings_total", "legendFormat": "{{scanner}} - {{severity}}", "datasource": {"type": "prometheus"}}
      ],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      }
    },
    {
      "id": 5,
      "title": "Security Trend",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {"expr": "security_total_high", "legendFormat": "HIGH", "datasource": {"type": "prometheus"}},
        {"expr": "security_total_medium", "legendFormat": "MEDIUM", "datasource": {"type": "prometheus"}}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"lineWidth": 2}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "HIGH"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "MEDIUM"}, "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]}
        ]
      }
    }
  ],
  "schemaVersion": 38
}
